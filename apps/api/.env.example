NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://user:password@localhost:5432/karnama
# Add real values to .env or the hosting dashboard, never to this example.
# AUTH_SECRET must be a random secret with at least 32 characters.
# AUTH_SECRET=
# KAVENEGAR_API_KEY=
# KAVENEGAR_TEMPLATE=
# Use groq for the free-tier test account; keep its key on the server.
EXTRACTION_PROVIDER=groq
# GROQ_API_KEY=
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b
# Anonymous test extraction only, 10 requests/IP/hour and 20 total/hour.
# Requires AUTH_SECRET and migrated DATABASE_URL. Turn off for real login.
ALLOW_DEMO_EXTRACTION=false
# Alternative provider, selected with EXTRACTION_PROVIDER=openai:
# OPENAI_API_KEY=
# OPENAI_EXTRACTION_MODEL=
# Set only after checking the reverse proxy's trusted hop count.
TRUST_PROXY_HOPS=0
