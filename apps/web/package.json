    "@karnama/graphql": "*",
    "@lingui/core": "6.6.0",
    "@lingui/react": "6.6.0",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/stylis-plugin-rtl": "9.4.0",
